# Copy to .env and edit. Nothing here is required to run `pytest test_dry_run.py`.

# ---- credentials ------------------------------------------------------------
# Paper keys: https://app.alpaca.markets/paper/dashboard/overview
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# ---- safety -----------------------------------------------------------------
# DRY_RUN=true uses an in-memory broker and makes no network calls at all.
DRY_RUN=true
# PAPER_TRADING=false means REAL MONEY and additionally requires the line below.
PAPER_TRADING=true
# Must be exactly I_UNDERSTAND_THE_RISK before live orders are permitted.
LIVE_TRADING_CONFIRMED=

# ---- strategy ---------------------------------------------------------------
SYMBOLS=QQQ
SIZING_MODE=fixed_cash
SIZING_VALUE=10000
MAX_NOTIONAL=100000
ORDER_STYLE=auction

# ---- schedule (Eastern; defaults respect Alpaca's 15:50 / 09:28 cutoffs) -----
# STAGE_AT=15:00
# ENTRY_AT=15:45
# EXIT_AT=09:25

# ---- alerts (optional; both channels fire if both are set) ------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

# ---- operations -------------------------------------------------------------
MAX_RETRIES=3
POLL_SECONDS=30
