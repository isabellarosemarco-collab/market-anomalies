# Copy to `.env` and edit. `.env` must never be committed.
#
# Defaults are inert: dry run on, paper on, no alerts, no API keys. A fresh clone cannot place an
# order or serve a customer until you change something here, which is the correct direction for a
# mistake to fail in.

# =============================================================== LAYER 1 — personal trader

# --- broker -----------------------------------------------------------------------------
# From https://app.alpaca.markets/paper/dashboard/overview -> "API Keys". Paper keys are separate
# from live keys; a paper key cannot touch real money even if PAPER_TRADING is wrong.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=

# DRY_RUN=true uses a simulated in-memory broker: no keys needed, nothing is sent anywhere.
# Leave it true until you have watched one full FOMC eve in the logs.
DRY_RUN=true
PAPER_TRADING=true

# Real money needs BOTH of the next two. One boolean is one typo away from a live trade.
# PAPER_TRADING=false
# LIVE_TRADING_CONFIRMED=I_UNDERSTAND_THE_RISK

# --- strategy ---------------------------------------------------------------------------
# QQQ is the recommended asset, but it was a statistical tie with IWM — see /v1/research/metrics.
# Multiple symbols split SIZING_VALUE between them, they do not multiply exposure.
SYMBOLS=QQQ
SIZING_MODE=fixed_cash          # fixed_cash | pct_equity
SIZING_VALUE=10000              # dollars, or a fraction of equity if pct_equity
MAX_NOTIONAL=100000
ORDER_STYLE=auction             # auction = MOC/MOO, the fills the research priced. market = fallback only.

# --- schedule (Eastern wall clock, DST handled automatically) ----------------------------
# Do not push ENTRY_AT past 15:50 or EXIT_AT past 09:28: Alpaca rejects auction orders after those
# times and the config will refuse to start. See the README's "Why not 3:59 PM" section.
STAGE_AT=15:00
ENTRY_AT=15:45
ENTRY_FALLBACK_AT=15:57
ENTRY_CONFIRM_AT=16:05
EXIT_AT=09:25
EXIT_FALLBACK_AT=09:31
EXIT_CONFIRM_AT=09:36

# --- alerts -----------------------------------------------------------------------------
# Telegram: message @BotFather -> /newbot -> copy the token. Then message your own bot once and read
# the chat id from https://api.telegram.org/bot<TOKEN>/getUpdates -> result[0].message.chat.id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional second channel, e.g. a paid signal group.
DISCORD_WEBHOOK_URL=

# =============================================================== LAYER 2 — commercial API

# Client keys: comma-separated `key:Label`. Generate with:
#     python -c "import secrets; print('fds_live_' + secrets.token_urlsafe(32))"
# Empty means every /v1 endpoint returns 503 — the API fails closed, it never falls open.
# In production set this from the platform's secret store, not from a file on disk.
API_KEYS=

API_TITLE=Fed Drift Signal API
ALLOW_OPEN_DOCS=true            # /docs is the client documentation; set false to hide the schema
RATE_LIMIT_PER_MIN=60           # per key, per process
WEBHOOK_TIMEOUT_S=10
WEBHOOK_MAX_ATTEMPTS=4
ENABLE_WEBHOOK_WORKER=true      # the 15:00 ET broadcast loop; false for a read-only replica

# =============================================================== operations

# SUBS_PATH holds webhook signing secrets and is written mode 0600. Put it on a persistent,
# encrypted volume — a redeploy otherwise loses every client's registration.
# SUBS_PATH=/data/subscriptions.json
# STATE_PATH=./state.json
# FOMC_CACHE_PATH=./core/data/fomc_dates.json
# LOG_PATH=./fed_drift.log
MAX_RETRIES=3
RETRY_BACKOFF_S=5
POLL_SECONDS=30
